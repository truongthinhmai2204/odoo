<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_equipment_confirmation_form" model="ir.ui.view">
        <field name="name">equipment.confirmation.form</field>
        <field name="model">maintenance.equipment</field>
        <field name="inherit_id" ref="maintenance.view_equipment_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='group_information']" position="after">
                <group>
                    <field name="confirmation_status"/>
                    <button name="action_confirm_equipment" type="object" string="Confirm Equipment"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>

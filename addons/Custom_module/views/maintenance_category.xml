<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_maintenance_category_form" model="ir.ui.view">
        <field name="name">maintenance.category.form</field>
        <field name="model">maintenance.category</field>
        <field name="arch" type="xml">
            <form string="Maintenance Category">
                <sheet>
                    <group>
                        <field name="name"/>
                    </group>
                    <notebook>
                        <page string="Requests">
                            <field name="request_ids">
                                <tree editable="bottom">
                                    <field name="name"/>
                                    <field name="category_id"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_maintenance_category_tree" model="ir.ui.view">
        <field name="name">maintenance.category.tree</field>
        <field name="model">maintenance.category</field>
        <field name="arch" type="xml">
            <tree string="Maintenance Categories">
                <field name="name"/>
            </tree>
        </field>
    </record>

    <record id="action_maintenance_category" model="ir.actions.act_window">
        <field name="name">Maintenance Categories</field>
        <field name="res_model">maintenance.category</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p>Create and manage maintenance categories here.</p>
        </field>
    </record>

    <menuitem id="menu_maintenance_category" name="Maintenance Categories"
              parent="maintenance.menu_maintenance_root"
              action="action_maintenance_category"/>
</odoo>

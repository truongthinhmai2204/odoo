<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_maintenance_request_form_inherit" model="ir.ui.view">
        <field name="name">maintenance.request.form.inherit</field>
        <field name="model">maintenance.request</field>
        <field name="owner_user_id"/>
        <field name="inherit_id" ref="maintenance.maintenance_request_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <group>
                    <field name="stock_status" readonly="1"/>
                </group>
            </xpath>
            <xpath expr="//header" position="inside">
                <button name="action_validate_request" type="object"
                        string="Check or Validate" class="btn-primary"/>
            </xpath>
        </field>
    </record>
</odoo>

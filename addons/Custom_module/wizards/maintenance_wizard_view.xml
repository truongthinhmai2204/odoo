<odoo>
    <record id="view_equipment_wizard_form" model="ir.ui.view">
        <field name="name">equipment.wizard.form</field>
        <field name="model">equipment.wizard</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="equipment_id"/>
                    <field name="confirm_note"/>
                </group>
                <footer>
                    <button name="confirm_equipment" type="object" string="Xác nhận" class="btn-primary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>

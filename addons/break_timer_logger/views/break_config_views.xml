<odoo>
    <record id="view_break_config_form" model="ir.ui.view">
      <field name="name">break.config.form</field>
      <field name="model">break.config</field>
      <field name="arch" type="xml">
        <form string="Break Configuration">
          <sheet>
            <group>
              <field name="name"/>
              <field name="work_duration"/>
              <field name="break_duration"/>
              <field name="repeat_count"/>
            </group>
          </sheet>
        </form>
      </field>
    </record>
  
    <record id="view_break_config_tree" model="ir.ui.view">
      <field name="name">break.config.tree</field>
      <field name="model">break.config</field>
      <field name="arch" type="xml">
        <tree string="Break Configuration">
          <field name="name"/>
          <field name="work_duration"/>
          <field name="break_duration"/>
          <field name="repeat_count"/>
        </tree>
      </field>
    </record>
  
    <record id="action_break_config" model="ir.actions.act_window">
      <field name="name">Break Configuration</field>
      <field name="res_model">break.config</field>
      <field name="view_mode">tree,form</field>
    </record>
  
    <menuitem id="menu_break_root" name="Break Timer" sequence="10"/>
    <menuitem id="menu_break_config" name="Configuration" parent="menu_break_root" action="action_break_config"/>
  </odoo>
  
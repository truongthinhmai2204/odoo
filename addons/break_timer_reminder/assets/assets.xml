<odoo>
    <template id="assets_backend" name="Break Timer Assets" inherit_id="web.assets_backend">
        <xpath expr="." position="inside">
            <script type="module" src="/break_timer_reminder/static/src/js/timer_widget.js"/>
            <template id="qweb" inherit_id="web.assets_qweb" name="Break Timer QWeb">
                <xpath expr="." position="inside">
                    <template file="/break_timer_reminder/static/src/xml/timer_widget.xml"/>
                </xpath>
            </template>
        </xpath>
    </template>    
</odoo>

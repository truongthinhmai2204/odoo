<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <templates xml:space="preserve">
        <t t-name="break_timer_reminder.timer_widget" t-js="true">
            <div class="o_timer_widget">
                <h2><t t-esc="formatTime(state.remainingSeconds)"/></h2>
                <button t-on-click="startTimer">▶️ Bắt đầu</button>
                <button t-on-click="stopTimer">⏸️ Dừng</button>
                <button t-on-click="resetTimer">🔄 Reset</button>
            </div>
        </t>
    </templates>
</odoo>

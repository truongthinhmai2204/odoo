<odoo>
  <record id="view_break_config_form" model="ir.ui.view">
    <field name="name">break.config.form</field>
    <field name="model">break.config</field>
    <field name="arch" type="xml">
      <form>
        <sheet>
          <group>
            <field name="name"/>
            <field name="work_duration"/>
            <field name="break_duration"/>
            <field name="repeat_count"/>
          </group>
          <notebook>
            <page string="Reports">
              <field name="report_ids">
                <tree editable="bottom">
                  <field name="name"/>
                  <field name="start_time"/>
                  <field name="end_time"/>
                </tree>
              </field>
            </page>
          </notebook>
        </sheet>
      </form>
    </field>
  </record>

  <record id="view_break_config_tree" model="ir.ui.view">
    <field name="name">break.config.tree</field>
    <field name="model">break.config</field>
    <field name="arch" type="xml">
      <tree>
        <field name="name"/>
        <field name="work_duration"/>
        <field name="break_duration"/>
      </tree>
    </field>
  </record>

  <record id="action_break_config" model="ir.actions.act_window">
    <field name="name">Break Config</field>
    <field name="res_model">break.config</field>
    <field name="view_mode">tree,form</field>
  </record>

  <menuitem id="menu_break_root" name="Break Timer"/>
  <menuitem id="menu_break_config" name="Configurations" parent="menu_break_root" action="action_break_config"/>
</odoo>

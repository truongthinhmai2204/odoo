<odoo>
    <record id="view_contract_form" model="ir.ui.view">
        <field name="name">hr.contract.custom.form</field>
        <field name="model">hr.contract.custom</field>
        <field name="arch" type="xml">
            <form string="Contract">
                <sheet>
                    <group>
                        <field name="employee_id"/>
                        <field name="salary"/>
                        <field name="start_date"/>
                        <field name="end_date"/>
                        <field name="status"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
</odoo>

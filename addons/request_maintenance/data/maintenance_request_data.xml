<?xml version="1.0" encoding="UTF-8"?>
<odoo>
<data noupdate="1">
    <record id="maintenance_equipment_1" model="maintenance.equipment.custom">
        <field name="name">Máy phát điện</field>
    </record>

    <record id="maintenance_stage_confirmed" model="maintenance.stage.custom">
        <field name="name">Confirmed</field>
        <field name="sequence">2</field>
    </record>

    <record id="maintenance_stage_cancelled" model="maintenance.stage.custom">
        <field name="name">Cancelled</field>
        <field name="sequence">3</field>
    </record>

    <record id="maintenance_request_sample" model="maintenance.request.custom">
        <field name="name">Bảo trì hệ thống điện</field>
        <field name="equipment_id" ref="maintenance_equipment_1"/>
        <field name="stage_id" ref="maintenance_stage_confirmed"/> 
        <field name="owner_user_id" ref='base.user_admin'/> 
        <field name="request_date" eval="time.strftime('%Y-%m-%d')"/> 
    </record>
</data>
</odoo>

<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Tạo thiết bị mẫu -->
    <record id="maintenance_equipment_1" model="maintenance.equipment">
        <field name="name">Máy phát điện</field>
    </record>

    <!-- Gán giai đoạn "Đã duyệt" và "Hủy" -->
    <record id="maintenance_stage_confirmed" model="maintenance.stage">
        <field name="name">Confirmed</field>
        <field name="sequence">2</field> <!-- Gán thứ tự -->
    </record>

    <record id="maintenance_stage_cancelled" model="maintenance.stage">
        <field name="name">Cancelled</field>
        <field name="sequence">3</field>
    </record>

    <!-- Tạo yêu cầu bảo trì mẫu -->
    <record id="maintenance_request_sample" model="maintenance.request">
        <field name="name">Bảo trì hệ thống điện</field>
        <field name="equipment_id" ref="maintenance_equipment_1"/>
        <field name="stage_id" ref="maintenance_stage_confirmed"/> 
        <field name="owner_user_id" ref='base.user_admin'/> 
        <field name="request_date" eval="time.strftime('%Y-%m-%d')"/> 
    </record>
</odoo>

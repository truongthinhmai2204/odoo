<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <data noupdate="1">

        <!-- Nhóm quản lý thiết bị -->
        <record id="group_equipment_manager" model="res.groups">
            <field name="name">Equipment Manager</field>
            <field name="category_id" ref="base.module_category_inventory"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
            <field name="comment">The user will be able to manage equipments.</field>
        </record>

        <!-- Rule cho user -->
        <record id="equipment_request_rule_user" model="ir.rule">
            <field name="name">Users: Access own maintenance requests</field>
            <field name="model_id" ref="maintenance.model_maintenance_request"/>
            <field name="domain_force">['|', '|', ('owner_user_id', '=', user.id), ('message_partner_ids', 'in', [user.partner_id.id]), ('user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="equipment_rule_user" model="ir.rule">
            <field name="name">Users: Access followed equipments</field>
            <field name="model_id" ref="maintenance.model_maintenance_equipment"/>
            <field name="domain_force">[('message_partner_ids', 'in', [user.partner_id.id])]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <!-- Rule cho Admin -->
        <record id="equipment_request_rule_admin_user" model="ir.rule">
            <field name="name">Admins: Full access maintenance requests</field>
            <field name="model_id" ref="maintenance.model_maintenance_request"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('maintenance.group_equipment_manager'))]"/>
        </record>

        <record id="equipment_rule_admin_user" model="ir.rule">
            <field name="name">Admins: Full access equipments</field>
            <field name="model_id" ref="maintenance.model_maintenance_equipment"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('maintenance.group_equipment_manager'))]"/>
        </record>

        <!-- Multi-company rules -->
        <record id="maintenance_request_comp_rule" model="ir.rule">
            <field name="name">Multi-company: Requests</field>
            <field name="model_id" ref="maintenance.model_maintenance_request"/>
            <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
        </record>

        <record id="maintenance_equipment_comp_rule" model="ir.rule">
            <field name="name">Multi-company: Equipments</field>
            <field name="model_id" ref="maintenance.model_maintenance_equipment"/>
            <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
        </record>

        <record id="maintenance_team_comp_rule" model="ir.rule">
            <field name="name">Multi-company: Teams</field>
            <field name="model_id" ref="maintenance.model_maintenance_team"/>
            <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
        </record>

        <record id="maintenance_equipment_category_comp_rule" model="ir.rule">
            <field name="name">Multi-company: Equipment Categories</field>
            <field name="model_id" ref="maintenance.model_maintenance_equipment_category"/>
            <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
        </record>

        <record id="maintenance_request_rule_company_id" model="ir.rule">
            <field name="name">Company-specific access to maintenance requests</field>
            <field name="model_id" ref="maintenance.model_maintenance_request"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('maintenance_request.group_equipment_manager'))]"/>
        </record>

    </data>

</odoo>
